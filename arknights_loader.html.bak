<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rhodes Island // Neural Network</title>
    <style>
        :root {
            --bg-color: #050505;
            --text-main: #e0e0e0;
            --text-dim: #666;
            --accent-blue: #00f0ff;
            --accent-subtle: #005566;
            --border-color: #333;
        }

        body {
            margin: 0;
            overflow: hidden;
            background-color: var(--bg-color);
            font-family: 'Courier New', monospace;
            color: var(--text-main);
        }

        #dashboard {
            position: absolute;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            display: grid;
            grid-template-columns: 250px 1fr;
            grid-template-rows: 60px 1fr;
            z-index: 1;
            background: #0a0a0a;
        }

        .header {
            grid-column: 1 / -1;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            padding: 0 20px;
            justify-content: space-between;
            background: rgba(10, 10, 10, 0.95);
        }

        .sidebar {
            border-right: 1px solid var(--border-color);
            padding: 20px;
            background: rgba(5, 5, 5, 0.9);
        }

        .main-content {
            padding: 30px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            overflow: hidden;
        }

        .card {
            background: #111;
            border: 1px solid var(--border-color);
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 1px;
            background: var(--accent-blue);
            opacity: 0.7;
        }

        h2 {
            font-size: 14px;
            color: var(--accent-blue);
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        p {
            font-size: 12px;
            color: var(--text-dim);
            line-height: 1.6;
        }

        .data-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 12px;
            border-bottom: 1px dashed #333;
            padding-bottom: 4px;
        }

        .data-val {
            color: #fff;
            font-weight: bold;
        }

        #loader-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 10;
            display: grid;
        }

        .grid-tile {
            background-color: #000;
            border: 1px solid #080808;
            transition: opacity 0.8s ease, transform 0.8s ease;
        }

        .grid-tile.hidden {
            opacity: 0;
            transform: scale(0.9);
            pointer-events: none;
        }

        #canvas-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 20;
            pointer-events: none;
            mix-blend-mode: screen;
        }

        #ui-layer {
            position: fixed;
            bottom: 40px;
            right: 40px;
            z-index: 30;
            text-align: right;
            pointer-events: none;
        }

        .loading-text {
            font-size: 60px;
            font-weight: 300;
            color: #fff;
            letter-spacing: -2px;
            margin: 0;
            opacity: 0.9;
        }

        .loading-label {
            font-size: 12px;
            color: var(--accent-blue);
            letter-spacing: 4px;
            text-transform: uppercase;
            margin-bottom: 5px;
            opacity: 0.8;
        }
    </style>
    <script type="importmap">
        {
            "imports": {
                "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
                "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
            }
        }
    </script>
</head>

<body>

    <div id="dashboard">
        <div class="header">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="width: 20px; height: 20px; background: var(--accent-blue); opacity: 0.8;"></div>
                <span style="font-weight: 300; letter-spacing: 2px;">RHODES ISLAND // NEURAL NETWORK</span>
            </div>
            <div style="font-size: 12px; color: var(--accent-blue);">CONNECTED</div>
        </div>
        <div class="sidebar">
            <div style="margin-bottom: 20px; color: #fff; font-weight: bold;">> DASHBOARD</div>
            <div style="margin-bottom: 20px;">> OPERATORS</div>
            <div style="margin-bottom: 20px;">> INFRASTRUCTURE</div>
            <div style="margin-bottom: 20px;">> RECRUITMENT</div>
            <div style="margin-top: 50px; border-top: 1px solid #333; padding-top: 20px;">
                <div style="font-size: 10px; color: #666;">SERVER STATUS</div>
                <div style="color: #00ff00; font-size: 12px;">ONLINE</div>
            </div>
        </div>
        <div class="main-content">
            <div class="card">
                <h2>System Resources</h2>
                <div class="data-row"><span>CPU LOAD</span><span class="data-val">45%</span></div>
                <div class="data-row"><span>MEMORY</span><span class="data-val">12.4GB</span></div>
                <div class="data-row"><span>NETWORK</span><span class="data-val">1.2TB</span></div>
            </div>
            <div class="card">
                <h2>Recent Logs</h2>
                <p>> [SYSTEM] Connection established.</p>
                <p>> [AUTH] User verified.</p>
                <p>> [DATA] Syncing local cache...</p>
            </div>
            <div class="card">
                <h2>Active Missions</h2>
                <div class="data-row"><span>OPERATION</span><span class="data-val">CC-12</span></div>
                <div class="data-row"><span>SQUAD</span><span class="data-val">ALPHA</span></div>
                <div class="data-row"><span>STATUS</span><span class="data-val" style="color: var(--accent-blue);">IN
                        PROGRESS</span></div>
            </div>
        </div>
    </div>

    <div id="loader-overlay"></div>
    <div id="canvas-container"></div>

    <div id="ui-layer">
        <div class="loading-label">System Loading</div>
        <div class="loading-text" id="percent">00%</div>
    </div>

    <script type="module">
        import * as THREE from 'three';
        import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
        import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';
        import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';
        import { ShaderPass } from 'three/addons/postprocessing/ShaderPass.js';
        import { RGBShiftShader } from 'three/addons/shaders/RGBShiftShader.js';

        const overlay = document.getElementById('loader-overlay');
        const cols = 12;
        const rows = 8;
        const totalTiles = cols * rows;
        const tiles = [];

        overlay.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
        overlay.style.gridTemplateRows = `repeat(${rows}, 1fr)`;

        for (let i = 0; i < totalTiles; i++) {
            const tile = document.createElement('div');
            tile.className = 'grid-tile';
            overlay.appendChild(tile);
            tiles.push(tile);
        }
        const shuffledTiles = [...tiles].sort(() => Math.random() - 0.5);

        const CONFIG = {
            accent: 0x00f0ff,
        };

        const container = document.getElementById('canvas-container');
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 6;

        const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(window.devicePixelRatio);
        renderer.setClearColor(0x000000, 0);
        container.appendChild(renderer.domElement);

        const group = new THREE.Group();
        scene.add(group);

        // Core
        const coreGeo = new THREE.IcosahedronGeometry(1.2, 1);
        const coreMat = new THREE.MeshBasicMaterial({ color: 0x050505, wireframe: false });
        const coreMesh = new THREE.Mesh(coreGeo, coreMat);

        const coreWireGeo = new THREE.WireframeGeometry(coreGeo);
        const coreWireMat = new THREE.LineBasicMaterial({ color: CONFIG.accent, transparent: true, opacity: 0.3 });
        const coreWire = new THREE.LineSegments(coreWireGeo, coreWireMat);
        coreMesh.add(coreWire);
        group.add(coreMesh);

        // Equal-sized rings
        const ringRadius = 2.2;
        const ring1Geo = new THREE.TorusGeometry(ringRadius, 0.02, 16, 100);
        const ringMat = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.2 });
        const ring1 = new THREE.Mesh(ring1Geo, ringMat);
        ring1.rotation.x = Math.PI / 2;

        const ring2Geo = new THREE.TorusGeometry(ringRadius, 0.02, 16, 100);
        const ring2 = new THREE.Mesh(ring2Geo, ringMat);
        ring2.rotation.y = Math.PI / 2;

        group.add(ring1);
        group.add(ring2);

        // Network connection lines
        const connectionPoints = [];
        const connectionLines = [];
        const numPoints = 10;
        const connectionRadius = 3.5;

        for (let i = 0; i < numPoints; i++) {
            const angle = (i / numPoints) * Math.PI * 2;
            const x = Math.cos(angle) * connectionRadius;
            const y = Math.sin(angle) * connectionRadius;
            const z = (Math.random() - 0.5) * 2;
            connectionPoints.push(new THREE.Vector3(x, y, z));
        }

        for (let i = 0; i < numPoints; i++) {
            const nextIndex = (i + 1) % numPoints;
            const nextNextIndex = (i + 2) % numPoints;

            const lineMat1 = new THREE.LineBasicMaterial({
                color: CONFIG.accent,
                transparent: true,
                opacity: 0.3
            });
            const lineGeo1 = new THREE.BufferGeometry().setFromPoints([
                connectionPoints[i],
                connectionPoints[nextIndex]
            ]);
            const line1 = new THREE.Line(lineGeo1, lineMat1);
            connectionLines.push({ line: line1, baseOpacity: 0.3, phase: Math.random() * Math.PI * 2 });
            group.add(line1);

            if (i % 3 === 0) {
                const lineMat2 = new THREE.LineBasicMaterial({
                    color: CONFIG.accent,
                    transparent: true,
                    opacity: 0.2
                });
                const lineGeo2 = new THREE.BufferGeometry().setFromPoints([
                    connectionPoints[i],
                    connectionPoints[nextNextIndex]
                ]);
                const line2 = new THREE.Line(lineGeo2, lineMat2);
                connectionLines.push({ line: line2, baseOpacity: 0.2, phase: Math.random() * Math.PI * 2 });
                group.add(line2);
            }
        }

        // Particles
        const shardsCount = 150;
        const shardsGeo = new THREE.BufferGeometry();
        const shardsPos = [];
        for (let i = 0; i < shardsCount; i++) {
            const r = 3.5 + Math.random() * 1.5;
            const theta = Math.random() * Math.PI * 2;
            const phi = Math.acos(2 * Math.random() - 1);
            shardsPos.push(
                r * Math.sin(phi) * Math.cos(theta),
                r * Math.sin(phi) * Math.sin(theta),
                r * Math.cos(phi)
            );
        }
        shardsGeo.setAttribute('position', new THREE.Float32BufferAttribute(shardsPos, 3));
        const shardsMat = new THREE.PointsMaterial({ color: 0xffffff, size: 0.03, transparent: true, opacity: 0.4 });
        const shards = new THREE.Points(shardsGeo, shardsMat);
        group.add(shards);

        const composer = new EffectComposer(renderer);
        composer.addPass(new RenderPass(scene, camera));

        const bloomPass = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.5, 0.4, 0.85);
        bloomPass.threshold = 0;
        bloomPass.strength = 0.6;
        bloomPass.radius = 0.5;
        composer.addPass(bloomPass);

        const rgbShiftPass = new ShaderPass(RGBShiftShader);
        rgbShiftPass.uniforms['amount'].value = 0.0;
        composer.addPass(rgbShiftPass);

        let time = 0;
        let currentProgress = 0;

        function animate() {
            requestAnimationFrame(animate);
            time += 0.01;

            coreMesh.rotation.y += 0.005;
            coreMesh.rotation.z += 0.002;

            // Rings rotate continuously (fast and cool!)
            ring1.rotation.z += 0.03;
            ring2.rotation.x += 0.03;

            // Animate connection lines
            connectionLines.forEach((conn) => {
                const pulse = Math.sin(time * 2 + conn.phase) * 0.3 + 0.7;
                conn.line.material.opacity = conn.baseOpacity * pulse;
            });

            shards.rotation.y -= 0.001;
            shards.rotation.z += 0.0005;

            const pulse = 1 + Math.sin(time * 2) * 0.03;
            coreMesh.scale.set(pulse, pulse, pulse);

            camera.position.x = Math.sin(time * 0.5) * 0.3;
            camera.position.y = Math.cos(time * 0.3) * 0.3;
            camera.lookAt(0, 0, 0);

            composer.render();
        }
        animate();

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
            composer.setSize(window.innerWidth, window.innerHeight);
        });

        const percentEl = document.getElementById('percent');
        const uiLayer = document.getElementById('ui-layer');
        let progress = 0;
        let isComplete = false;

        function finishAnimation() {
            if (isComplete) return;
            isComplete = true;
            progress = 100;
            currentProgress = 100;
            percentEl.innerText = '100%';

            tiles.forEach(t => t.classList.add('hidden'));

            const tl = setInterval(() => {
                group.scale.multiplyScalar(1.03);
                group.rotation.z += 0.02;
                group.position.z += 0.1;

                uiLayer.style.opacity = 0;
                uiLayer.style.transition = 'opacity 0.3s';

                container.style.opacity = (container.style.opacity || 1) - 0.04;

                if (group.position.z > 8 || container.style.opacity <= 0) {
                    clearInterval(tl);
                    container.style.display = 'none';
                    overlay.style.display = 'none';
                }
            }, 16);
        }

        function updateProgress() {
            if (isComplete) return;

            if (progress < 100) {
                let inc = 1.0;
                if (progress < 30) inc = Math.random() * 2.5;
                else if (progress < 70) inc = Math.random() * 0.8;
                else inc = Math.random() * 2.0;

                progress += inc;
                if (progress > 100) progress = 100;
                currentProgress = progress;

                percentEl.innerText = Math.floor(progress).toString().padStart(2, '0') + '%';

                if (progress > 10) {
                    const revealRatio = (progress - 10) / 80;
                    const tilesToHide = Math.floor(revealRatio * totalTiles);
                    for (let i = 0; i < tilesToHide; i++) {
                        if (shuffledTiles[i] && !shuffledTiles[i].classList.contains('hidden')) {
                            shuffledTiles[i].classList.add('hidden');
                        }
                    }
                }

                if (progress >= 100) {
                    finishAnimation();
                } else {
                    setTimeout(updateProgress, Math.random() * 30 + 10);
                }
            }
        }

        document.addEventListener('click', () => {
            finishAnimation();
        });

        setTimeout(updateProgress, 500);

    </script>
</body>

</html>